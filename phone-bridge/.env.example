# Twilio'nun /incoming-call webhook'unu doğrulamak için kullanılan rastgele,
# uzun bir gizli string (diğer webhook secret'larıyla aynı mantık) —
# Twilio'daki numaranın webhook URL'ine ...../incoming-call/<bu-değer>
# şeklinde ekleniyor.
TWILIO_WEBHOOK_PATH_SECRET=

# OpenAI Realtime API için — mevcut Riona AI projesindeki OPENAI_API_KEY ile
# aynı anahtar kullanılabilir.
OPENAI_API_KEY=

# Riona AI'nin ana Next.js uygulamasının canlı adresi (sondaki / olmadan).
APP_BASE_URL=https://riona-ai-tau.vercel.app

# Ana uygulamadaki /api/phone/* endpoint'lerine erişim için paylaşılan gizli
# anahtar — Vercel'deki PHONE_BRIDGE_SECRET ile BİREBİR AYNI olmalı.
PHONE_BRIDGE_SECRET=

# Kaliteli mi yoksa daha ucuz/hızlı mini model mi kullanılacağı — çağrı
# hacmi artıp maliyet önemli olmaya başlarsa "gpt-realtime-2.1-mini" olarak
# değiştirilebilir, kod değişikliği gerekmez.
REALTIME_MODEL=gpt-realtime-2.1
